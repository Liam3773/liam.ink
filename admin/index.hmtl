<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bin Men FC Admin</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #0b0f0d;
      color: white;
      text-align: center;
    }

    h1 {
      margin-top: 30px;
      font-size: 40px;
    }

    .review {
      background: #121a15;
      border: 1px solid #243228;
      border-radius: 18px;
      padding: 18px;
      margin: 20px auto;
      width: 90%;
      max-width: 600px;
    }

    .review img {
      width: 100%;
      border-radius: 10px;
      margin-top: 10px;
    }

    button {
      margin-top: 10px;
      padding: 10px 20px;
      border: none;
      border-radius: 10px;
      background: red;
      color: white;
      cursor: pointer;
    }
  </style>
</head>

<body>

  <h1>Admin Panel</h1>
  <div id="reviewsList">Loading...</div>

  <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-storage-compat.js"></script>

  <script>
    const ADMIN_PASSWORD = "liam";

    const firebaseConfig = {
      apiKey: "AIzaSyBx1W3gp9LdFyN3dDtRUoZm52o6P2DLJso",
      authDomain: "bin-men-fc.firebaseapp.com",
      projectId: "bin-men-fc",
      storageBucket: "bin-men-fc.firebasestorage.app",
      messagingSenderId: "960901793838",
      appId: "1:960901793838:web:eeee2926789e3e846d77bf"
    };

    firebase.initializeApp(firebaseConfig);

    const db = firebase.firestore();
    const storage = firebase.storage();

    function checkPassword() {
      const password = prompt("Enter admin password:");

      if (password !== ADMIN_PASSWORD) {
        alert("Wrong password");
        window.location.href = "/";
      }
    }

    function loadReviews() {
      db.collection("reviews")
        .orderBy("time", "desc")
        .onSnapshot(snapshot => {
          const container = document.getElementById("reviewsList");
          container.innerHTML = "";

          snapshot.forEach(doc => {
            const data = doc.data();

            const div = document.createElement("div");
            div.className = "review";

            div.innerHTML = `
              <b>${data.name}</b><br>
              ${data.text}
              ${data.image ? `<img src="${data.image}">` : ""}
              <button onclick="deleteReview('${doc.id}', '${data.image || ""}')">Delete</button>
            `;

            container.appendChild(div);
          });
        });
    }

    async function deleteReview(id, imageUrl) {
      const confirmDelete = confirm("Delete this review?");
      if (!confirmDelete) return;

      try {
        await db.collection("reviews").doc(id).delete();

        if (imageUrl) {
          try {
            const ref = storage.refFromURL(imageUrl);
            await ref.delete();
          } catch (e) {
            console.log("Image delete failed");
          }
        }

        alert("Deleted");
      } catch (error) {
        console.error(error);
        alert("Error deleting");
      }
    }

    checkPassword();
    loadReviews();
  </script>

</body>
</html>